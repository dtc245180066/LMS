<!-- views/partials/admin-sidebar.ejs -->
<aside class="admin-sidebar">
  <div>
    <div class="sidebar-brand">
      <div class="brand-emblem">LMS</div>
      <div class="brand-details">
        <div class="brand-title">LMS Quản Trị</div>
        <div class="brand-subtitle">Hệ Thống Đào Tạo ICTU</div>
      </div>
    </div>

    <ul class="sidebar-nav">
      <li>
        <a href="/admin/dashboard" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Tổng Quan Hệ Thống</span>
        </a>
      </li>
      <li>
        <a href="/admin/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>Quản Lý Tài Khoản</span>
        </a>
      </li>
      <li>
        <a href="/admin/activities" class="<%= typeof active !== 'undefined' && active === 'activities' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          <span>Nhật Ký Hoạt Động</span>
        </a>
      </li>
      <li>
        <a href="/admin/courses" class="<%= typeof active !== 'undefined' && active === 'courses' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span>Khóa Học Toàn Trường</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="sidebar-footer">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="sidebar-user">
        <div class="user-avatar"><%= currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'A' %></div>
        <div class="user-info">
          <div class="user-name"><%= currentUser.full_name %></div>
          <div class="user-role-label">Quản trị viên</div>
        </div>
      </div>
      <a href="/auth/logout" class="btn-sidebar-logout">
        <svg style="width:16px;height:16px;stroke:currentColor;stroke-width:2;fill:none" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        <span>Đăng xuất</span>
      </a>
    <% } %>
  </div>
</aside>
