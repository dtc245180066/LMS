<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/student/courses.css">
</head>
<body>

  <div class="admin-layout">
    
    <!-- SIDEBAR SINH VIÊN (TAB KHÁM PHÁ KHÓA HỌC) -->
    <%- include('../partials/student-sidebar', { active: 'courses' }) %>

    <!-- MAIN CONTENT -->
    <main class="admin-main">
      <header class="top-header">
        <div class="header-title">
          <div style="margin-bottom: 6px;">
            <a href="/courses" style="color: var(--brand-blue); text-decoration: none; font-size: 0.88rem; font-weight: 600;">
              &larr; Danh mục tất cả khóa học
            </a>
          </div>
          <h1><%= course.title %></h1>
          <p>Giảng viên phụ trách: <strong><%= course.instructor_name %></strong></p>
        </div>

        <div class="header-actions">
          <div class="user-badge">
            <span class="pill-badge pill-student"><%= lessons.length %> bài học</span>
          </div>
        </div>
      </header>

      <!-- FLASH MESSAGE THÔNG BÁO -->
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert-banner alert-<%= messageType || 'success' %>" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 10px;">
          <% if (messageType === 'success') { %>
            <svg style="width: 22px; height: 22px; stroke: #059669; stroke-width: 2.5; fill: none; flex-shrink: 0;" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div style="font-weight: 500; font-size: 0.94rem;">
              <strong style="color: #065f46;">Ghi danh thành công!</strong> <%= message.replace('Ghi danh khóa học thành công! ', '') %>
            </div>
          <% } else { %>
            <svg style="width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none; flex-shrink: 0;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div><%= message %></div>
          <% } %>
        </div>
      <% } %>

      <div class="two-col-layout">
        
        <!-- THÔNG TIN KHÓA HỌC -->
        <div class="panel-card">
          <h2 class="panel-title">Mô Tả & Mục Tiêu Khóa Học</h2>
          <div class="lesson-content-body">
            <%= course.description %>
          </div>

          <div style="border-top: 1px solid var(--border-subtle); padding-top: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <% if (currentUser && isEnrolled) { %>
              <% if (typeof isCourseCompleted !== 'undefined' && isCourseCompleted) { %>
                <div class="pill-badge pill-success" style="font-size: 0.88rem; padding: 8px 14px; font-weight: 700;">
                  🎓 Đã hoàn thành 100% khóa học (<%= completedLessonsCount %>/<%= lessons.length %> bài)
                </div>
                <% if (lessons.length > 0) { %>
                  <a href="/student/course/<%= course.id %>/lesson/<%= lessons[0].id %>" class="btn btn-outline" style="border-color: #10b981; color: #047857;">
                    Ôn lại bài học &rarr;
                  </a>
                <% } %>
              <% } else { %>
                <div class="pill-badge pill-success" style="font-size: 0.88rem; padding: 8px 14px;">
                  ✓ Đã ghi danh & Được phê duyệt
                </div>
                <% if (lessons.length > 0) { %>
                  <a href="/student/course/<%= course.id %>/lesson/<%= lessons[0].id %>" class="btn btn-primary">
                    Vào Học Ngay
                  </a>
                <% } %>
              <% } %>
            <% } else if (currentUser && typeof enrollmentStatus !== 'undefined' && enrollmentStatus === 'pending') { %>
              <div class="pill-badge" style="background: #fef3c7; color: #d97706; border: 1px solid #fde68a; font-size: 0.88rem; padding: 8px 14px;">
                ⏳ Yêu cầu ghi danh đang chờ Giảng viên phê duyệt
              </div>
              <a href="/student/my-courses?status=pending" class="btn btn-outline">
                Xem Trạng Thái Xét Duyệt
              </a>
            <% } else if (currentUser && typeof enrollmentStatus !== 'undefined' && enrollmentStatus === 'rejected') { %>
              <div class="alert-banner alert-danger" style="margin-bottom: 16px; display: flex; align-items: center; gap: 10px; text-align: left;">
                <svg style="width: 22px; height: 22px; stroke: #dc2626; stroke-width: 2.2; fill: none; flex-shrink: 0;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                <div style="font-size: 0.9rem;">
                  <strong style="color: #991b1b;">Yêu cầu ghi danh môn học này của bạn đã bị Giảng viên từ chối.</strong>
                  <div style="font-size: 0.82rem; color: #64748b; margin-top: 2px;">Bạn có thể bấm nút dưới đây để gửi lại yêu cầu xét duyệt cho Giảng viên.</div>
                </div>
              </div>
              <form action="/student/enroll/<%= course.id %>" method="POST">
                <button type="submit" class="btn btn-primary" style="padding: 12px 28px;">
                  Gửi Lại Yêu Cầu Ghi Danh
                </button>
              </form>
            <% } else if (currentUser && currentUser.role === 'student') { %>
              <form action="/student/enroll/<%= course.id %>" method="POST">
                <button type="submit" class="btn btn-primary" style="padding: 12px 28px;">
                  Ghi Danh Tham Gia Khóa Học
                </button>
              </form>
            <% } else if (!currentUser) { %>
              <a href="/auth/login" class="btn btn-primary" style="padding: 12px 28px;">
                Đăng Nhập Để Tham Gia Học
              </a>
            <% } %>
          </div>
        </div>

        <!-- MỤC LỤC BÀI HỌC -->
        <div class="panel-card">
          <h2 class="panel-title">Lộ Trình Bài Học (<%= lessons.length %>)</h2>
          <div class="curriculum-list">
            <% if (lessons.length > 0) { %>
              <% lessons.forEach((l, idx) => { %>
                <div class="curriculum-item">
                  <span><strong>Bài <%= idx + 1 %>:</strong> <%= l.title %></span>
                  <% if (currentUser && isEnrolled) { %>
                    <a href="/student/course/<%= course.id %>/lesson/<%= l.id %>" style="color: var(--brand-blue); text-decoration: none; font-weight: 600; font-size: 0.84rem;">
                      Học bài
                    </a>
                  <% } else { %>
                    <span style="color: var(--text-light); font-size: 0.8rem;">Khóa</span>
                  <% } %>
                </div>
              <% }); %>
            <% } else { %>
              <div class="alert-box alert-info">Khóa học đang được cập nhật nội dung bài giảng.</div>
            <% } %>
          </div>
        </div>

      </div>
    </main>

  </div>

</body>
</html>
