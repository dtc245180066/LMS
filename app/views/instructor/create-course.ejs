<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/instructor/courses.css">
</head>
<body>

  <div class="admin-layout">
    
    <!-- SIDEBAR GIẢNG VIÊN -->
    <%- include('../partials/instructor-sidebar', { active: 'courses' }) %>

    <!-- CONTENT -->
    <main class="admin-main">
      <header class="top-header">
        <div class="header-title">
          <div style="margin-bottom: 6px;">
            <a href="/instructor/courses" style="color: var(--brand-blue); text-decoration: none; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
              <svg style="width: 15px; height: 15px; stroke: currentColor; stroke-width: 2.2; fill: none;" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span>Quay lại Khóa Học Của Tôi</span>
            </a>
          </div>
          <h1>Tạo Khóa Học Mới</h1>
          <p>Nhập thông tin tổng quan về chương trình giảng dạy và thiết lập trạng thái phát hành</p>
        </div>
      </header>

      <div class="panel-card" style="max-width: 720px;">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-banner alert-danger"><%= error %></div>
        <% } %>

        <form action="/instructor/courses/create" method="POST">
          <div class="form-group">
            <label for="title" class="form-label">Tên khóa học:</label>
            <input type="text" class="form-input" id="title" name="title" placeholder="VD: Lập trình Web Frontend & Backend với Node.js..." required autofocus>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Mô tả tóm tắt nội dung môn học:</label>
            <textarea class="form-input" id="description" name="description" rows="5" placeholder="Khóa học này sẽ trang bị các kiến thức về..."></textarea>
          </div>

          <div class="form-group">
            <label for="status" class="form-label">Trạng thái phát hành:</label>
            <select class="form-input" id="status" name="status">
              <option value="published">Công khai (Sinh viên có thể nhìn thấy và đăng ký ngay)</option>
              <option value="draft">Bản nháp (Tạm ẩn để tiếp tục biên soạn bài giảng)</option>
            </select>
          </div>

          <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; border-top: 1px solid var(--border-subtle); padding-top: 20px;">
            <a href="/instructor/courses" class="btn btn-outline">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary">Khởi Tạo Khóa Học</button>
          </div>
        </form>
      </div>
    </main>

  </div>

</body>
</html>
