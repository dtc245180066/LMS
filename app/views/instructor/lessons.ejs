<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/instructor/lessons.css">
</head>
<body>

  <div class="admin-layout">
    
    <!-- SIDEBAR GIẢNG VIÊN (3 TAB CHUẨN) -->
    <%- include('../partials/instructor-sidebar', { active: 'courses' }) %>

    <!-- VÙNG NỘI DUNG CHÍNH -->
    <main class="admin-main">
      
      <header class="top-header">
        <div class="header-title">
          <div style="margin-bottom: 6px;">
            <a href="/instructor/courses" style="color: var(--brand-blue); text-decoration: none; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
              <svg style="width: 15px; height: 15px; stroke: currentColor; stroke-width: 2.2; fill: none;" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span>Quay lại Khóa Học Của Tôi</span>
            </a>
          </div>
          <h1>Mục Lục Bài Giảng</h1>
          <p>Môn học: <strong style="color: var(--brand-blue);"><%= course.title %></strong></p>
        </div>
        <div class="header-actions">
          <a href="/instructor/courses/<%= course.id %>/add-lesson" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;">
            <svg style="width:16px;height:16px;stroke:currentColor;stroke-width:2.5;fill:none" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Thêm Bài Học Mới</span>
          </a>
        </div>
      </header>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert-banner alert-success">
          <%= message %>
        </div>
      <% } %>

      <section class="panel-card">
        <h2 class="panel-title">Danh Sách Bài Giảng Hiện Có (<%= lessons.length %> bài)</h2>

        <% if (lessons && lessons.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 90px;">Thứ tự</th>
                  <th>Tiêu Đề Bài Giảng</th>
                  <th>Ngày Đăng Tải</th>
                  <th style="text-align: right; width: 140px;">Thao Tác</th>
                </tr>
              </thead>
              <tbody>
                <% lessons.forEach(l => { %>
                  <tr>
                    <td><code class="id-pill">Bài <%= l.lesson_order %></code></td>
                    <td style="font-weight: 600; color: var(--text-title);">
                      <div><%= l.title %></div>
                      <% if (l.attachment_path) { %>
                        <div style="margin-top: 5px;">
                          <a href="<%= l.attachment_path %>" target="_blank" download="<%= l.attachment_name %>" class="attachment-pill" title="Tải xuống tệp tài liệu: <%= l.attachment_name %>">
                            <svg style="width: 12px; height: 12px; stroke: currentColor; stroke-width: 2.2; fill: none;" viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                            <span><%= l.attachment_name %></span>
                            <% if (l.attachment_size) { %>
                              <span style="opacity: 0.7;">(<%= l.attachment_size > 1048576 ? (l.attachment_size / 1048576).toFixed(1) + ' MB' : Math.round(l.attachment_size / 1024) + ' KB' %>)</span>
                            <% } %>
                          </a>
                        </div>
                      <% } %>
                    </td>
                    <td style="color: var(--text-muted); font-size: 0.85rem;"><%= new Date(l.created_at).toLocaleDateString('vi-VN') %></td>
                    <td style="text-align: right;">
                      <form action="/instructor/lessons/<%= l.id %>/delete" method="POST" onsubmit="return confirm('Thầy/cô có chắc chắn muốn xóa bài học này không? Hành động này không thể hoàn tác.');" style="display: inline; margin: 0;">
                        <button type="submit" class="btn-delete" title="Xóa bài học này">
                          <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                          <span>Xóa bài</span>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert-box alert-info">
            Khóa học này chưa có bài học nào. Hãy bấm nút <strong>"+ Thêm Bài Giảng Mới"</strong> để biên soạn bài giảng đầu tiên!
          </div>
        <% } %>
      </section>

    </main>

  </div>

</body>
</html>
