<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/auth/login.css">
</head>
<body>

  <div class="auth-viewport">
    <div class="auth-box">
      
      <div class="auth-header">
        <div class="auth-icon">LMS</div>
        <h1 class="auth-title">Đăng Nhập Hệ Thống</h1>
        <p class="auth-subtitle">Cổng Đào Tạo Trực Tuyến - Đại học CNTT & TT</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-banner alert-success" style="font-size: 0.88rem; padding: 12px 14px;">
          <%= success %>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-banner alert-danger" style="font-size: 0.88rem; padding: 12px 14px;">
          <%= error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <div class="auth-field">
          <label for="username" class="auth-label">Tên đăng nhập</label>
          <input type="text" class="auth-input" id="username" name="username" placeholder="Nhập tên tài khoản..." required autofocus>
        </div>

        <div class="auth-field" style="margin-bottom: 26px;">
          <label for="password" class="auth-label">Mật khẩu</label>
          <input type="password" class="auth-input" id="password" name="password" placeholder="Nhập mật khẩu..." required>
        </div>

        <button type="submit" class="btn-submit">
          Đăng Nhập
        </button>
      </form>

      <div class="auth-footer">
        Chưa có tài khoản học viên? 
        <a href="/auth/register">Đăng ký tài khoản</a>
      </div>

    </div>
  </div>

</body>
</html>
