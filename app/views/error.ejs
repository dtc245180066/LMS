<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/auth/login.css">
</head>
<body>

  <div class="auth-viewport">
    <div class="auth-box" style="text-align: center; max-width: 500px;">
      
      <div style="font-size: 3rem; margin-bottom: 12px; color: var(--crimson-red); font-weight: 800;">!</div>
      <h1 class="auth-title" style="color: var(--crimson-red); margin-bottom: 12px;"><%= title %></h1>
      <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 28px;"><%= message %></p>

      <div style="display: flex; gap: 12px; justify-content: center;">
        <a href="/courses" class="btn btn-primary" style="padding: 11px 24px;">Quay lại Trang Chủ Khóa Học</a>
      </div>

    </div>
  </div>

</body>
</html>
