<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/admin/users.css">
</head>
<body>

  <div class="admin-layout">
    
    <!-- SIDEBAR QUẢN TRỊ VIÊN -->
    <%- include('../partials/admin-sidebar', { active: 'users' }) %>

    <!-- VÙNG NỘI DUNG CHÍNH -->
    <main class="admin-main">
      
      <!-- TOP HEADER -->
      <header class="top-header">
        <div class="header-title">
          <h1>Quản Lý Tài Khoản Người Dùng</h1>
          <p>Cấp tài khoản mới, phân quyền và kiểm soát khóa / mở khóa truy cập</p>
        </div>
      </header>

      <!-- THÔNG BÁO FLASH MESSAGE NẾU CÓ -->
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert-banner alert-<%= messageType || 'success' %>">
          <%= message %>
        </div>
      <% } %>

      <!-- 1. KHU VỰC CẤP TÀI KHOẢN MỚI -->
      <section class="panel-card">
        <h2 class="panel-title">Cấp Tài Khoản Mới</h2>
        <form action="/admin/users/create" method="POST">
          <div class="form-provision-grid">
            <div class="form-group" style="margin-bottom: 0;">
              <label for="full_name" class="form-label">Họ và tên</label>
              <input type="text" class="form-input" id="full_name" name="full_name" placeholder="VD: Thầy Vũ Tuấn..." required>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="username" class="form-label">Tên đăng nhập</label>
              <input type="text" class="form-input" id="username" name="username" placeholder="VD: teacher3..." required>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="password" class="form-label">Mật khẩu ban đầu</label>
              <input type="password" class="form-input" id="password" name="password" placeholder="Nhập mật khẩu..." required>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="role" class="form-label">Vai trò (Phân quyền)</label>
              <select class="form-input" id="role" name="role" required>
                <option value="student">Sinh viên (Student)</option>
                <option value="instructor">Giảng viên (Instructor)</option>
                <option value="admin">Quản trị viên (Admin)</option>
              </select>
            </div>

            <div>
              <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">
                Cấp Tài Khoản
              </button>
            </div>
          </div>
        </form>
      </section>

      <!-- 2. BẢNG DANH SÁCH & KHÓA / MỞ KHÓA TÀI KHOẢN -->
      <section class="panel-card">
        <h2 class="panel-title">Danh Sách Tài Khoản Toàn Hệ Thống</h2>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 70px;">Mã số</th>
                <th>Họ và Tên</th>
                <th>Tên Đăng Nhập</th>
                <th>Vai Trò</th>
                <th>Trạng Thái</th>
                <th>Ngày Khởi Tạo</th>
                <th style="text-align: right;">Hành Động</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td><code class="id-pill">#<%= u.id %></code></td>
                  <td style="font-weight: 600; color: var(--text-title);"><%= u.full_name %></td>
                  <td><code class="id-pill"><%= u.username %></code></td>
                  <td>
                    <% if (u.role === 'admin') { %>
                      <span class="pill-badge pill-admin">Quản trị viên</span>
                    <% } else if (u.role === 'instructor') { %>
                      <span class="pill-badge pill-instructor">Giảng viên</span>
                    <% } else { %>
                      <span class="pill-badge pill-student">Sinh viên</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.status === 'locked') { %>
                      <span class="pill-status pill-locked">Đã khóa</span>
                    <% } else { %>
                      <span class="pill-status pill-active">Hoạt động</span>
                    <% } %>
                  </td>
                  <td style="color: var(--text-muted); font-size: 0.85rem;"><%= new Date(u.created_at).toLocaleDateString('vi-VN') %></td>
                  <td style="text-align: right;">
                    <% if (currentUser && u.id === currentUser.id) { %>
                      <span style="font-size: 0.8rem; color: var(--text-light); font-style: italic;">(Đang đăng nhập)</span>
                    <% } else { %>
                      <form action="/admin/users/<%= u.id %>/toggle-status" method="POST" style="display: inline;">
                        <% if (u.status === 'active') { %>
                          <button type="submit" class="btn-lock-toggle btn-lock" title="Khóa tài khoản này">
                            Khóa tài khoản
                          </button>
                        <% } else { %>
                          <button type="submit" class="btn-lock-toggle btn-unlock" title="Mở khóa tài khoản">
                            Mở khóa
                          </button>
                        <% } %>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- PHÂN TRANG -->
        <%- include('../partials/pagination', { pagination }) %>
      </section>

    </main>

  </div>

</body>
</html>

